# Copied to ~/axia/backend.env on the server (chmod 600) and filled in there;
# never committed. ~/axia/.env holds POSTGRES_PASSWORD for docker compose.
DEBUG=False
DJANGO_SECRET_KEY=
DATABASE_URL=postgres://valuation:<POSTGRES_PASSWORD>@db:5432/valuation
DJANGO_ALLOWED_HOSTS=app.bayutaxia.com,backend,localhost
CSRF_TRUSTED_ORIGINS=https://app.bayutaxia.com
CORS_ALLOWED_ORIGINS=https://app.bayutaxia.com
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=false
REPORT_FIRM_NAME="Bayut Prime"
# Cloudflare Access sign-in (apps/accounts/cloudflare_access.py).
CF_ACCESS_TEAM_DOMAIN=zt-central.cloudflareaccess.com
CF_ACCESS_AUD=
# The first admin, created on first start.
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
