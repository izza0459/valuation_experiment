# Copy to backend/.env for local development.
# DEBUG defaults to False and SECRET_KEY has no fallback, so this file (or
# equivalent env vars) is required to start the app.

DEBUG=True
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Unset = local sqlite (backend/db.sqlite3), which is the quickest way to
# run without Docker. Uncomment for docker compose, where "db" is the
# Postgres service hostname:
# DATABASE_URL=postgres://valuation:valuation@db:5432/valuation

CORS_ALLOWED_ORIGINS=http://localhost:3000

# Unset = localhost Redis. Under docker compose use redis://redis:6379/0.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Unset = follow DEBUG: run background tasks (e.g. issuing) inline, no worker
# needed. docker compose runs a worker and sets this to false.
# CELERY_TASK_ALWAYS_EAGER=false

AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=me-central-1

# TODO (CLAUDE.md §11): confirm 10% vs 15%, possibly per-bank via Bank.rules.
FORCED_SALE_DISCOUNT_PCT_DEFAULT=10
AVM_DEVIATION_THRESHOLD_PCT=10

# Printed on every report; the legal name is required before a report can be issued.
# REPORT_FIRM_NAME=Bayut Valuation Services
# REPORT_FIRM_LEGAL_NAME=
