# Copy to backend/.env for local development.
# DEBUG defaults to False and SECRET_KEY has no fallback, so this file (or
# equivalent env vars) is required to start the app.

DEBUG=True
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Unset = local sqlite (backend/db.sqlite3), which is the quickest way to
# run without Docker. Uncomment for docker compose, where "db" is the
# Postgres service hostname:
# DATABASE_URL=postgres://valuation:valuation@db:5432/valuation

CORS_ALLOWED_ORIGINS=http://localhost:3000

# Unset = localhost Redis. Under docker compose use redis://redis:6379/0.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Unset = follow DEBUG: run background tasks (e.g. issuing) inline, no worker
# needed. docker compose runs a worker and sets this to false.
# CELERY_TASK_ALWAYS_EAGER=false

AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=me-central-1

# TODO (CLAUDE.md §11): confirm 10% vs 15%, possibly per-bank via Bank.rules.
FORCED_SALE_DISCOUNT_PCT_DEFAULT=10
AVM_DEVIATION_THRESHOLD_PCT=10

# Printed on every report; the legal name is required before a report can be issued.
# REPORT_FIRM_NAME=Bayut Valuation Services
# REPORT_FIRM_LEGAL_NAME=

# Email the issued report to the bank ("Send to bank" on Review & Send).
# Unset = the message is only printed to the server log. For Gmail / Google
# Workspace use an app password (Google Account > Security > 2-Step
# Verification > App passwords), not the normal account password.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=you@yourdomain.com
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=Bayut Valuation Services <you@yourdomain.com>
# REPORT_EMAIL_BCC=you@yourdomain.com
#
# Where SMTP is blocked (Render's free plan), send through an email service's
# API instead; this takes precedence over the SMTP settings above. The From
# address must be a sender verified with that service.
# EMAIL_API_PROVIDER=brevo        # or resend, sendgrid
# EMAIL_API_KEY=
#
# Demo / staging: every report goes to this inbox instead of the bank,
# marked with the contact it would have gone to. Leave unset for real use.
# REPORT_EMAIL_REDIRECT_TO=you@yourdomain.com
