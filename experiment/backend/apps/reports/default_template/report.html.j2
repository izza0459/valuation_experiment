{#- Standard valuation report, structure per CLAUDE.md §5.
    Wording is our own; it carries no placeholders. The firm's legal name
    (REPORT_FIRM_LEGAL_NAME) falls back to its trading name. -#}

{#- Commercial and legal terms quoted in the wording below, from the firm's
    Word template (Valuation_Report_Template.docx), where they were shown in
    [brackets] for confirmation. Change them here; nothing else repeats them. -#}
{%- set terms = {
  "standards_effective": "31 January 2025",
  "fee_share_pct": 5,
  "file_retention_years": 6,
  "non_solicitation_months": 6,
  "force_majeure_days": 30,
  "late_payment_days": 30,
  "remedy_days": 30,
  "termination_notice_days": 30,
  "courts": "Dubai Courts",
} -%}

{%- set market_value_definition = "The estimated amount for which an asset or liability should exchange on the valuation date between a willing buyer and a willing seller in an arm’s length transaction, after proper marketing and where the parties had each acted knowledgeably, prudently and without compulsion." -%}

{#- The firm's registered legal name (REPORT_FIRM_LEGAL_NAME). Until it is
    set, the report says so and cannot be issued. -#}
{% macro legal_name() -%}
{{ firm.legal_name or firm.name }}
{%- endmacro %}

{% macro table(rows, cls="kv") -%}
<table class="{{ cls }}">
  {% for r in rows %}
  <tr><th>{{ r.label }}</th><td>{{ r.value }}</td></tr>
  {% endfor %}
</table>
{%- endmacro %}

{% macro entries(items) -%}
{% for item in items %}
  {% if item.title and item.title != "Custom" %}<h4>{{ item.title }}</h4>{% endif %}
  <div class="paras">{{ item.body|paras }}</div>
{% endfor %}
{%- endmacro %}

{% macro photo(p) -%}
<figure>{% if p.src %}<img src="{{ p.src }}" alt="">{% else %}<div class="missing-image">Photograph unavailable</div>{% endif %}<figcaption>{{ p.caption }}</figcaption></figure>
{%- endmacro %}

{#- A section's head: its number badge, then the title. #}
{% macro head(no, title, kind="Section") -%}
<header class="sec-head"><div class="kick"><span class="badge">{{ no }}</span>{{ kind }}</div><h2>{{ title }}</h2></header>
{%- endmacro %}

{#- A label on the left, its content on the right. #}
{% macro item(label) -%}
<div class="item"><h3>{{ label }}</h3><div>{{ caller() }}</div></div>
{%- endmacro %}

{#- The rows of `rows` whose label is one of `wanted`, as a card. #}
{% macro card(title, rows, wanted, cls="") -%}
{% set picked = rows | selectattr("label", "in", wanted) | list %}
{% if picked %}<div class="card {{ cls }}"><div class="ct">{{ title }}</div>{{ table(picked) }}</div>{% endif %}
{%- endmacro %}

{% macro signature(person, role) -%}
<div class="signature">
  <div class="sig-line"></div>
  {% if person %}
  <div class="sig-name">{{ person.name }}</div>
  <div class="sig-role">{{ role }}{% if person.title %} · {{ person.title }}{% endif %}</div>
  {% if person.qualifications %}<div>{{ person.qualifications }}</div>{% endif %}
  {% if person.rera_no %}<div>RERA registration no.: {{ person.rera_no }}</div>{% endif %}
  {% if person.rics_no %}<div>RICS membership no.: {{ person.rics_no }}</div>{% endif %}
  {% else %}
  <div class="sig-name missing">{{ role }} not assigned</div>
  {% endif %}
</div>
{%- endmacro %}

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Valuation Report {{ meta.ref_no }}</title>
<style>{{ css }}</style>
</head>
<body class="{{ 'draft' if meta.is_draft else 'final' }}">

{% set sec = namespace(n=0) %}
{% set app = namespace(n=0) %}
{# What Property Analysis has to show; the section goes if it's all empty. #}
{% set acc_rows = accommodation | selectattr("rooms") | list %}
{% set has_location = text.sub_community or text.location or property.map_src or property.coordinates %}
{% set has_analysis = has_location or text.specification or acc_rows or building_specification or text.amenities
   or text.condition or text.repairs or tenancy or reinstatement %}
{% set shown_address = property.inspected_address or property.address or "" %}
{% set short_address = shown_address.split(",")[:2] | join(",") %}
{% set initial = (firm.name or "B")[:1] %}

{# ---------- Running header and footer (print) ---------- #}
<div class="runhead"><span class="brand"><span class="badge-b">{{ initial }}</span>{{ firm.name }}</span><span>Valuation Report · <b>{{ short_address }}</b></span></div>
<div class="runfoot"><span>Valuation Ref No.: <b>{{ meta.ref_no }}</b>{% if meta.version > 1 %} (version {{ meta.version }}){% endif %}</span><span>Confidential · {{ client.name }}</span><span class="pg">Page  |</span></div>

{# ---------- Cover ---------- #}
<section class="cover">
  <svg class="cover-bars" viewBox="0 0 210 190" preserveAspectRatio="none" aria-hidden="true">
    <g fill="none" stroke="#ffffff" stroke-opacity="0.16" stroke-width="0.35">
      <rect x="-2" y="95" width="18" height="100"/><rect x="24" y="70" width="18" height="125"/>
      <rect x="48" y="45" width="30" height="150"/><line x1="48" y1="56" x2="78" y2="56"/>
      <rect x="84" y="2" width="23" height="193"/><line x1="84" y1="11" x2="107" y2="11"/><line x1="84" y1="23" x2="107" y2="23"/>
      <line x1="84" y1="35" x2="107" y2="35"/><line x1="84" y1="47" x2="107" y2="47"/><line x1="84" y1="59" x2="107" y2="59"/>
      <rect x="113" y="54" width="20" height="141"/><rect x="139" y="28" width="27" height="167"/>
      <line x1="139" y1="39" x2="166" y2="39"/><line x1="139" y1="51" x2="166" y2="51"/>
      <rect x="172" y="69" width="19" height="126"/><rect x="197" y="44" width="16" height="151"/>
    </g>
  </svg>
  <div class="cover-mast"><span class="badge-b">{{ initial }}</span>{{ firm.name }}</div>
  {% if meta.is_draft %}
  <div class="draft-box">
    <strong>DRAFT – not issued.</strong>
    {% if meta.outstanding %}
    <p>Still to complete before this can be sent for review:</p>
    <ul>{% for item in meta.outstanding %}<li>{{ item }}</li>{% endfor %}</ul>
    {% endif %}
  </div>
  {% endif %}
  <div class="cover-body">
    <div class="cover-kick">{{ firm.name }}</div>
    <h1>Valuation Report</h1>
    <p class="cover-address">{{ shown_address or "—" }}</p>
  </div>
  <div class="cover-meta">
    <div><div class="k">Valuation Ref No.</div><div class="v">{{ meta.ref_no }}{% if meta.version > 1 %} (v{{ meta.version }}){% endif %}</div></div>
    <div><div class="k">Valuation date</div><div class="v">{{ dates.valuation or "—" }}</div></div>
    <div><div class="k">Prepared for</div><div class="v">{{ client.name }}</div></div>
    <div><div class="k">Prepared by</div><div class="v">{{ firm.name }}</div></div>
  </div>
</section>

{# ---------- Executive summary ---------- #}
<section>
  {% set sec.n = sec.n + 1 %}{{ head("%02d" % sec.n, "Executive Summary") }}
  {% if exec_photos %}
  <div class="photo-row">{% for p in exec_photos %}{{ photo(p) }}{% endfor %}</div>
  {% elif meta.is_draft %}
  <p class="note">Executive-summary photographs have not been attached.</p>
  {% endif %}

  <div class="stats">
    <div><div class="n big">{{ headline.value or "—" }}</div><div class="k">Market value</div></div>
    <div><div class="n">{{ headline.rate or "—" }}{% if headline.rate %}<small>AED / sqft</small>{% endif %}</div><div class="k">Market value rate</div></div>
    <div><div class="n{{ ' long' if headline.rent and not headline.rent_plain }}">{{ headline.rent or "—" }}{% if headline.rent_plain %}<small>AED p.a.</small>{% endif %}</div><div class="k">Market rent</div></div>
    <div><div class="n">{{ headline.bua_sqft or "—" }}{% if headline.bua_sqft %}<small>sqft</small>{% endif %}</div><div class="k">Built-up area</div></div>
  </div>

  {% set g_client = ["Client", "Valuation Ref No.", "Bank reference", "Applicant", "Applicants", "Owner", "Owners", "Occupancy"] %}
  {% set g_interest = ["Interest valued", "Lease expiry", "Acquisition method", "Type of property", "Developer", "Upgrades / modifications"] %}
  {% set g_areas = ["Built-up area", "Plot area", "Floor", "Total no. of floors"] %}
  {% set g_age = ["Year built", "Age of the property", "Remaining economic life", "Utilities"] %}
  {% set grouped = g_client + g_interest + g_areas + g_age %}
  {% set g_address = property_details | rejectattr("label", "in", grouped) | map(attribute="label") | list %}

  <div class="label">Property details</div>
  <div class="cards">
    {{ card("Client & references", property_details, g_client) }}
    {{ card("Interest & type", property_details, g_interest) }}
  </div>
  <div class="cards">{{ card("Address & location", property_details, g_address, "wide") }}</div>
  <div class="cards">
    {{ card("Areas & floors", property_details, g_areas) }}
    {{ card("Age & services", property_details, g_age) }}
  </div>
  {% if bua_assumed_note %}<p class="note">{{ bua_assumed_note }}</p>{% endif %}

  {% set vs = {} %}
  {% for r in valuation_summary %}{% set _ = vs.update({r.label: r.value}) %}{% endfor %}
  {% set v_panel = ["Market Value", "Market Value in words", "Market Value rate", "Market Rent"] %}
  {% set v_dates = ["Date of instruction", "Date of inspection", "Type of inspection", "Date of valuation", "Date of report"] %}
  <div class="label">Valuation summary</div>
  <div class="vsum">
    <div class="vl">
      <div class="k">Market value</div>
      <div class="big">{{ vs.get("Market Value") or "—" }}</div>
      <div class="words">{{ vs.get("Market Value in words", "") }}</div>
      {% if vs.get("Market Value rate") %}<div class="k">Market value rate</div><div class="sm">{{ vs.get("Market Value rate") }}</div>{% endif %}
      {% if vs.get("Market Rent") %}<div class="k">Market rent</div><div class="sm">{{ vs.get("Market Rent") }}</div>{% endif %}
    </div>
    <div class="vr">{{ table(valuation_summary | rejectattr("label", "in", v_panel + v_dates) | list) }}</div>
  </div>
  <div class="dates">
    <div><div class="k">Date of instruction</div><div class="v">{{ vs.get("Date of instruction", "—") }}</div></div>
    <div><div class="k">Date of inspection</div><div class="v">{{ vs.get("Date of inspection", "—") }}</div>{% if vs.get("Type of inspection") %}<div class="s">Type of inspection: {{ vs.get("Type of inspection") }}</div>{% endif %}</div>
    <div><div class="k">Date of valuation</div><div class="v">{{ vs.get("Date of valuation", "—") }}</div></div>
    <div><div class="k">Date of report</div><div class="v">{{ vs.get("Date of report", "—") }}</div></div>
  </div>

  <div class="signatures">
    {{ signature(valuer, "Valuer") }}
    {{ signature(counter_signatory, "Counter-signatory") }}
  </div>
</section>

{# ---------- Terms of engagement ---------- #}
<section>
  {% set sec.n = sec.n + 1 %}{{ head("%02d" % sec.n, "Terms of Engagement") }}
  {% call item("Addressee") %}
  <p><strong>{{ client.name }}</strong>{% if client.billing_address %}<br>{{ client.billing_address }}{% endif %}{% if client.po_box %}<br>PO Box {{ client.po_box }}{% endif %}</p>
  <p>To be relied upon by {{ client.name }}{% if purpose %} for {{ purpose | lower }} purposes{% endif %} only.</p>
  {% endcall %}

  {% call item("Standards") %}
  <p>This Valuation Report has been prepared in accordance with the Emirates Book of Valuation Standards (EBVS) and the RICS Valuation – Global Standards (effective {{ terms.standards_effective }}).</p>
  <p>The RICS Valuation – Global Standards incorporate and are consistent with the International Valuation Standards (IVS).</p>
  {% endcall %}

  {% call item("Basis of valuation") %}
  {% if valuation.basis_key in ("market_value", "market_value_transferable_title") %}
  <p>The valuation has been prepared on the basis of {{ valuation.basis }} as defined in the International Valuation Standards and adopted by RICS:</p>
  <p class="quote">“{{ market_value_definition }}”</p>
  <p>Market Value reflects the highest and best use of the asset: the use that is physically possible, legally permissible and financially feasible, and which produces the highest value from a market participant’s perspective.</p>
  <p>A full definition of Market Value is provided in Appendix 3.</p>
  {% else %}
  <p>The valuation has been prepared on the basis of {{ valuation.basis or "—" }}, as defined in Appendix 3.</p>
  {% endif %}
  {% endcall %}

  {% call item("Independence and objectivity") %}
  <p>We confirm that neither the Valuer nor {{ firm.name }} has any pecuniary interest giving rise to a conflict of interest in valuing the property. This report represents our independent and objective opinion.</p>
  {% endcall %}

  {% call item("Disclosure") %}
  {% if text.disclosure %}<p class="prose">{{ text.disclosure }}</p>{% endif %}
  <p>The total fees earned by {{ firm.name }} from the Client, including the fee for this report, represent less than {{ terms.fee_share_pct }}% of our total revenues.</p>
  {% endcall %}

  {% call item("Knowledge and skills of valuer") %}
  <p>We confirm that we have sufficient knowledge of the relevant local and national property markets, and the skills and understanding to undertake the valuation competently.</p>
  {% endcall %}

  {# Report text inputs (Oct 2026): the opening paragraphs print in every report. #}
  {% call item("Assumptions") %}
  <p>In preparing this valuation, {{ firm.name }} has relied on a number of assumptions. These are matters treated as true for the purposes of this assignment without independent investigation or verification. They form part of the basis on which the valuation has been prepared and should be read together with the opinion of value set out in this report.</p>
  <p>An Assumption is defined in the RICS Valuation – Global Standards (the “Red Book”) as:</p>
  <p class="quote">“A supposition taken to be true. It involves facts, conditions or situations affecting the subject of, or approach to, a valuation that, by agreement, do not need to be verified by the valuer as part of the valuation process. Typically, an assumption is made where specific investigation by the valuer is not required in order to prove that something is true.”</p>
  <p>In preparing this valuation, we have adopted a number of Assumptions. These are referred to throughout this report and set out in full in Appendix 2.</p>
  {% if text.assumptions %}{{ entries(text.assumptions) }}{% endif %}
  {% endcall %}

  {% call item("Special assumptions") %}
  <p>A Special Assumption is defined in the RICS Valuation – Global Standards (the “Red Book”) as:</p>
  <p class="quote">“An assumption that either assumes facts that differ from the actual facts existing at the valuation date or that would not be made by a typical market participant in a transaction on the valuation date.”</p>
  {% if text.special_assumptions %}<p>For the purpose of this report, {{ firm.name }} has adopted the following Special Assumptions.</p>{{ entries(text.special_assumptions) }}{% else %}<p><strong>No Special Assumptions have been adopted.</strong></p>{% endif %}
  {% endcall %}

  {% if text.other_matters %}
  {% call item("Other matters") %}{{ entries(text.other_matters) }}{% endcall %}
  {% endif %}
</section>

{# ---------- Due diligence ---------- #}
<section class="cont">
  {% set sec.n = sec.n + 1 %}{{ head("%02d" % sec.n, "Extent of Due Diligence") }}
  <p>{% if desktop %}This is a desktop valuation: the subject property was not inspected. It has been prepared from the information provided and other available sources, and the property is assumed to be in a condition consistent with its age and type.{% elif inspection_type %}The subject property was inspected{% if inspector %} by {{ inspector }}{% endif %}{% if inspection_date %} on {{ inspection_date }}{% endif %} ({{ inspection_type }}). The inspection was non-intrusive and limited to accessible, visible areas.{% else %}The type and date of inspection have not been recorded.{% endif %}</p>

  {% if information_provided %}
  {% call item("Information provided") %}<div class="pills">{% for i in information_provided %}<span class="pill">{{ i }}</span>{% endfor %}</div>{% endcall %}
  {% endif %}

  {% if areas %}
  {% call item("Property areas") %}
  <table class="grid">
    <tr><th>Item</th><th>Area</th><th>Source</th></tr>
    {% for r in areas %}
    <tr><td>{{ r.label }}</td><td>{{ r.value }}</td><td>{{ (bua_source if r.label == "Built-up area" else plot_source) or "" }}</td></tr>
    {% endfor %}
  </table>
  {% endcall %}
  {% endif %}
  {% if bua_assumed_note %}<p class="note">{{ bua_assumed_note }}</p>{% endif %}
</section>

{# ---------- Property analysis: only what was filled in ---------- #}
{% if has_analysis %}
<section>
  {% set sec.n = sec.n + 1 %}{{ head("%02d" % sec.n, "Property Analysis") }}
  {% if has_location %}
  <div class="label">Location</div>
  <div class="loc-text">
  {% if text.sub_community %}<p class="prose">{{ text.sub_community }}</p>{% endif %}
  {% if text.location %}<p class="prose">{{ text.location }}</p>{% endif %}
  </div>
  {% if property.map_src %}
  <figure class="map"><img src="{{ property.map_src }}" alt="Location map"><figcaption>Location map · {{ property.coordinates }}</figcaption></figure>
  {% elif property.coordinates %}
  <div class="map-box">Location map · {{ property.coordinates }}</div>
  {% endif %}
  {% endif %}

  {% if text.specification %}
  {% call item("Description") %}<div class="paras">{{ text.specification|paras }}</div>{% endcall %}
  {% endif %}

  {% if acc_rows %}
  {% call item("Accommodation") %}
  <table class="grid">
    <tr><th>Floor</th><th>Accommodation</th></tr>
    {% for row in acc_rows %}
    <tr><td>{{ row.floor }}</td><td>{{ row.rooms | join(", ") }}</td></tr>
    {% endfor %}
  </table>
  {% endcall %}
  {% endif %}

  {% if building_specification %}
  {% call item("Building specification") %}{{ table(building_specification) }}{% endcall %}
  {% endif %}

  {% if text.amenities %}
  {% call item("Communal amenities") %}<div class="pills">{% for a in text.amenities.split(",") if a.strip() %}<span class="pill">{{ a.strip() }}</span>{% endfor %}</div>{% endcall %}
  {% endif %}

  {% if text.condition or text.repairs %}
  {% call item("Condition") %}
  {% if text.condition %}<div class="paras">{{ text.condition|paras }}</div>{% endif %}
  {% if text.repairs %}<p class="prose callout"><strong>Repairs noted:</strong> {{ text.repairs }}</p>{% endif %}
  {% endcall %}
  {% endif %}

  {% if tenancy %}
  {% call item("Tenancy") %}<p class="prose">{{ tenancy }}</p>{% endcall %}
  {% endif %}

  {% if reinstatement %}
  {% call item("Reinstatement cost") %}<p class="prose">{{ reinstatement }}</p>{% endcall %}
  {% endif %}
</section>
{% endif %}

{# ---------- Market commentary: only when written ---------- #}
{% if text.market_commentary %}
<section>
  {% set sec.n = sec.n + 1 %}{{ head("%02d" % sec.n, "Market Commentary") }}
  <p class="prose">{{ text.market_commentary }}</p>
</section>
{% endif %}

{# ---------- Valuation methodology ---------- #}
<section class="{{ 'cont' if text.market_commentary else '' }}">
  {% set sec.n = sec.n + 1 %}{{ head("%02d" % sec.n, "Valuation Methodology") }}
  <p>The market approach, comparable method, has been used: the property is valued by reference to prices achieved for, or asked for, similar properties, adjusted for the differences between them and the subject.</p>
  {% if text.valuation_commentary %}<h3 class="label">Valuation commentary</h3><p class="prose">{{ text.valuation_commentary }}</p>{% endif %}
  {% if text.type_commentary %}
  <div class="type-cards">{% for c in text.type_commentary %}<div class="card"><b>{{ c.title }}</b><span class="prose">{{ c.body }}</span></div>{% endfor %}</div>
  {% endif %}

  {% if comparables %}
  <h3 class="label">Comparable evidence</h3>
  <table class="grid">
    <tr><th>Building / district</th><th>Views</th><th>Floor</th><th class="num">BUA (sqft)</th>{% if plot_bearing %}<th class="num">Plot (sqft)</th>{% endif %}<th>Type</th><th class="num">Price (AED)</th><th class="num">AED / sqft</th><th>Date / status</th></tr>
    {% for c in comparables %}
    <tr><td>{{ c.district }}</td><td>{{ c.views }}</td><td>{{ c.floor }}</td><td class="num">{{ c.bua_sqft }}</td>{% if plot_bearing %}<td class="num">{{ c.plot_sqft }}</td>{% endif %}<td>{{ c.type }}</td><td class="num">{{ c.price }}</td><td class="num">{{ c.rate }}</td><td>{{ c.transaction }}</td></tr>
    {% endfor %}
  </table>
  {% if chart %}
  <div class="chart">
    <div class="ct">Comparable evidence · AED / sqft</div>
    <svg viewBox="0 0 600 230" font-family="IBM Plex Mono, monospace">
      {% for t in chart.ticks %}
      <line x1="{{ chart.left }}" x2="{{ chart.right }}" y1="{{ t.y }}" y2="{{ t.y }}" stroke="#e3e6e4" stroke-width="{{ 1 if loop.first else 0.6 }}"/>
      <text x="{{ chart.left - 8 }}" y="{{ t.y + 3 }}" text-anchor="end" font-size="9" fill="#8a918d">{{ t.label }}</text>
      {% endfor %}
      {% for b in chart.bars %}
      <rect x="{{ b.x }}" y="{{ b.y }}" width="{{ b.w }}" height="{{ b.h }}" rx="3" fill="{{ '#123d28' if b.top else '#1e6b45' }}"/>
      <text x="{{ b.cx }}" y="{{ b.y - 6 }}" text-anchor="middle" font-size="10" font-weight="600" fill="#1b1f1d">{{ b.value }}</text>
      <text x="{{ b.cx }}" y="{{ chart.base + 14 }}" text-anchor="middle" font-size="8" font-weight="600" fill="#1b1f1d" font-family="IBM Plex Sans, sans-serif">{{ b.label }}</text>
      <text x="{{ b.cx }}" y="{{ chart.base + 26 }}" text-anchor="middle" font-size="8" fill="#8a918d" font-family="IBM Plex Sans, sans-serif">{{ b.sub }}</text>
      {% endfor %}
      {% if chart.subject_y is not none %}
      <line x1="{{ chart.left }}" x2="{{ chart.right }}" y1="{{ chart.subject_y }}" y2="{{ chart.subject_y }}" stroke="#a86a12" stroke-width="1.2" stroke-dasharray="5 4"/>
      <text x="{{ chart.right }}" y="{{ chart.subject_y - 6 }}" text-anchor="end" font-size="8" font-weight="600" fill="#a86a12" font-family="IBM Plex Sans, sans-serif">Subject · Market Value rate</text>
      <text x="{{ chart.right }}" y="{{ chart.subject_y + 13 }}" text-anchor="end" font-size="9" font-weight="600" fill="#a86a12">{{ chart.subject }}</text>
      {% endif %}
    </svg>
  </div>
  {% endif %}
  {% endif %}
</section>

{# ---------- Opinion of market value ---------- #}
<section>
  {% set sec.n = sec.n + 1 %}{{ head("%02d" % sec.n, "Opinion of Market Value") }}
  <p>Having carefully considered the matter, we are of the opinion that the {{ valuation.basis or "value" }} of the {% if interest %}{{ interest }} {% endif %}interest in the subject property, {{ "subject to the existing tenancy" if tenanted else "assuming vacant possession" }}, as at {{ dates.valuation or "the valuation date" }}, is fairly represented in the sum of:</p>
  <div class="value-box">
    <div class="value-figure">{{ valuation.market_value or "—" }}</div>
    {% if valuation.market_value_words %}<div class="value-words">({{ valuation.market_value_words }})</div>{% endif %}
  </div>
  <p>The above value is provided gross of any land transfer charges, legal costs or sales fees. These costs are subject to negotiation, and transfer fees may change without public consultation. They may be shared between vendor and purchaser or borne by one party, typically depending on relative negotiating positions.</p>
  <p>This valuation report has been prepared by the valuer for and on behalf of {{ firm.name }}. The valuer confirms they have the requisite local knowledge and skills to undertake the valuation competently. The signatory also confirms the report is genuine and authorised by {{ legal_name() }}.</p>
  {% if valuation.uncertainty and valuation.uncertainty_note %}
  <h3 class="label">Special note</h3>
  <p class="prose callout">{{ valuation.uncertainty_note }}</p>
  {% endif %}
  <div class="signatures">
    {{ signature(valuer, "Valuer") }}
    {{ signature(counter_signatory, "Counter-signatory") }}
  </div>
</section>

{# ---------- Disclaimer ---------- #}
<section class="cont">
  {% set sec.n = sec.n + 1 %}{{ head("%02d" % sec.n, "Disclaimer") }}
  <div class="disclaimer">
  <p>This report has been prepared on the basis that there has been full disclosure of all information and facts that may affect the valuation.</p>
  <p>This report is provided solely for the stated purpose and for the use of the party to whom it is addressed. It is confidential to the Client and may not be disclosed to any third party, or reproduced in whole or in part in any document, circular or statement, without the prior written consent of {{ firm.name }}. No responsibility is accepted to any third party for the whole or any part of its contents.</p>
  </div>
</section>

